#define F_CPU 16000000UL
#include <avr/io.h>
#include <util/delay.h>

// Setup for serial comm
void UART_init(void) {
    UBRR0H = 0;
    UBRR0L = 103;                           // Baud rate 9600
    UCSR0B = (1 << RXEN0);                  // Enable RX
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00); 
}

char UART_receive(void) {
    while (!(UCSR0A & (1 << RXC0)));  // Wait for data to come in
    return UDR0;                      // Return byte
}

// Turn off all LEDs
void LEDs_off(void) {
    PORTB &= ~((1 << PB0) | (1 << PB1) | (1 << PB2));  // Shut off pins 0, 1, 2
}

int main(void) {
    DDRB |= (1 << PB0) | (1 << PB1) | (1 << PB2);  // Set pins D8, D9, D10 as output
    UART_init();  // Initialize UART

    while (1) {
        char c = UART_receive();  // Receive data
        LEDs_off();  // Turn off LEDs

        // Light up LED based on the character received
        if (c == '1') PORTB |= (1 << PB0);  // Turn on LED1 if '1'
        if (c == '2') PORTB |= (1 << PB1);  // Turn on LED2 if '2'
        if (c == '3') PORTB |= (1 << PB2);  // Turn on LED3 if '3'
    }
}
